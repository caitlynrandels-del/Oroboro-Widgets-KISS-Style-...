<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=600, height=600, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#000000">
<title>Oroboro</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{width:600px;height:600px;overflow:hidden;background:#000;color:#fff;font-family:system-ui,sans-serif;font-size:20px}
  #app{width:600px;height:600px;padding:20px;display:flex;flex-direction:column;gap:12px}
  h1{font-size:22px}
 .card{width:100%;height:88px;border:2px solid #222;border-radius:16px;display:flex;align-items:center;padding:0 20px}
 .card.focused{border-color:#fff;background:#fff;color:#000}
 .footer{margin-top:auto;font-size:12px;opacity:.5}
</style>
</head>
<body>
<div id="app">
  <h1>OROBORO</h1>
  <div class="card focused" data-a="1">01 - Dashboard</div>
  <div class="card" data-a="2">02 - Widgets</div>
  <div class="card" data-a="3">03 - System</div>
  <div class="footer">D-PAD to move • ENTER to select</div>
</div>
<script>
  const cards=[...document.querySelectorAll('.card')]; let i=0;
  const update=()=>cards.forEach((c,k)=>c.classList.toggle('focused',k===i));
  document.addEventListener('keydown',e=>{
    if(e.key==='ArrowDown'){i=Math.min(i+1,cards.length-1);update()}
    if(e.key==='ArrowUp'){i=Math.max(i-1,0);update()}
    if(e.key==='Enter'){cards[i].textContent='Loading '+cards[i].dataset.a+'...'}
    e.preventDefault();
  });
</script>
</body>
</html>
